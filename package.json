{
  "name": "nephilex",
  "displayName": "Nephilex",
  "description": "Open-source application security scanner for code, dependencies, secrets, infrastructure as code, and AI/LLM apps. Shows Nephilex findings with their evidence as diagnostics, hovers, a Findings view, and quick fixes.",
  "version": "0.2.0",
  "publisher": "nephilex",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0E1726",
    "theme": "dark"
  },
  "homepage": "https://nephilex.github.io/nephilex/",
  "repository": {
    "type": "git",
    "url": "https://github.com/nephilex/vscode-nephilex"
  },
  "bugs": {
    "url": "https://github.com/nephilex/vscode-nephilex/issues"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "keywords": [
    "security",
    "sast",
    "appsec",
    "devsecops",
    "vulnerability",
    "taint analysis",
    "secrets",
    "dependencies",
    "sca",
    "iac",
    "owasp",
    "cwe",
    "llm",
    "mcp",
    "nephilex"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Nephilex does not run the scanner in Restricted Mode. Trust the workspace to enable scanning.",
      "restrictedConfigurations": [
        "nephilex.executablePath",
        "nephilex.pythonPath",
        "nephilex.extraArgs"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Nephilex scans files on the local file system."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "nephilex.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Nephilex",
        "icon": "$(run-all)"
      },
      {
        "command": "nephilex.scanFile",
        "title": "Scan Current File",
        "category": "Nephilex",
        "icon": "$(shield)"
      },
      {
        "command": "nephilex.scanResource",
        "title": "Scan with Nephilex",
        "category": "Nephilex"
      },
      {
        "command": "nephilex.refresh",
        "title": "Refresh (Run the Last Scan Again)",
        "category": "Nephilex",
        "icon": "$(refresh)"
      },
      {
        "command": "nephilex.clearFindings",
        "title": "Clear Findings",
        "category": "Nephilex",
        "icon": "$(clear-all)"
      },
      {
        "command": "nephilex.filterFindings",
        "title": "Filter Findings...",
        "category": "Nephilex",
        "icon": "$(filter)"
      },
      {
        "command": "nephilex.resetFilter",
        "title": "Reset Filter",
        "category": "Nephilex"
      },
      {
        "command": "nephilex.groupBySeverity",
        "title": "Group by Severity",
        "category": "Nephilex",
        "icon": "$(list-tree)"
      },
      {
        "command": "nephilex.groupByFile",
        "title": "Group by File",
        "category": "Nephilex",
        "icon": "$(files)"
      },
      {
        "command": "nephilex.showFindings",
        "title": "Show Findings",
        "category": "Nephilex"
      },
      {
        "command": "nephilex.showProblems",
        "title": "Show Problems",
        "category": "Nephilex"
      },
      {
        "command": "nephilex.openHtmlReport",
        "title": "Open HTML Report",
        "category": "Nephilex"
      },
      {
        "command": "nephilex.installCli",
        "title": "Install Nephilex CLI",
        "category": "Nephilex"
      },
      {
        "command": "nephilex.showLog",
        "title": "Show Log",
        "category": "Nephilex"
      },
      {
        "command": "nephilex.ignoreFinding",
        "title": "Ignore Finding with Reason",
        "category": "Nephilex"
      },
      {
        "command": "nephilex.openFinding",
        "title": "Open",
        "category": "Nephilex"
      },
      {
        "command": "nephilex.ignoreFromView",
        "title": "Ignore with Reason...",
        "category": "Nephilex"
      },
      {
        "command": "nephilex.copyRuleId",
        "title": "Copy Rule ID",
        "category": "Nephilex"
      },
      {
        "command": "nephilex.openRuleDocs",
        "title": "Open Rule Documentation",
        "category": "Nephilex"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nephilex.ignoreFinding",
          "when": "false"
        },
        {
          "command": "nephilex.scanResource",
          "when": "false"
        },
        {
          "command": "nephilex.openFinding",
          "when": "false"
        },
        {
          "command": "nephilex.ignoreFromView",
          "when": "false"
        },
        {
          "command": "nephilex.copyRuleId",
          "when": "false"
        },
        {
          "command": "nephilex.openRuleDocs",
          "when": "false"
        },
        {
          "command": "nephilex.resetFilter",
          "when": "nephilex.filtered"
        },
        {
          "command": "nephilex.groupBySeverity",
          "when": "nephilex.groupBy == file"
        },
        {
          "command": "nephilex.groupByFile",
          "when": "nephilex.groupBy != file"
        }
      ],
      "view/title": [
        {
          "command": "nephilex.scanWorkspace",
          "when": "view == nephilex.findings",
          "group": "navigation@1"
        },
        {
          "command": "nephilex.refresh",
          "when": "view == nephilex.findings",
          "group": "navigation@2"
        },
        {
          "command": "nephilex.filterFindings",
          "when": "view == nephilex.findings",
          "group": "navigation@3"
        },
        {
          "command": "nephilex.groupByFile",
          "when": "view == nephilex.findings && nephilex.groupBy != file",
          "group": "navigation@4"
        },
        {
          "command": "nephilex.groupBySeverity",
          "when": "view == nephilex.findings && nephilex.groupBy == file",
          "group": "navigation@4"
        },
        {
          "command": "nephilex.clearFindings",
          "when": "view == nephilex.findings",
          "group": "navigation@5"
        },
        {
          "command": "nephilex.openHtmlReport",
          "when": "view == nephilex.findings",
          "group": "1_report@1"
        },
        {
          "command": "nephilex.resetFilter",
          "when": "view == nephilex.findings && nephilex.filtered",
          "group": "2_view@1"
        },
        {
          "command": "nephilex.showProblems",
          "when": "view == nephilex.findings",
          "group": "2_view@2"
        },
        {
          "command": "nephilex.installCli",
          "when": "view == nephilex.findings",
          "group": "3_setup@1"
        },
        {
          "command": "nephilex.showLog",
          "when": "view == nephilex.findings",
          "group": "3_setup@2"
        }
      ],
      "view/item/context": [
        {
          "command": "nephilex.openFinding",
          "when": "view == nephilex.findings && viewItem == nephilex.finding",
          "group": "navigation@1"
        },
        {
          "command": "nephilex.ignoreFromView",
          "when": "view == nephilex.findings && viewItem == nephilex.finding",
          "group": "1_triage@1"
        },
        {
          "command": "nephilex.copyRuleId",
          "when": "view == nephilex.findings && viewItem == nephilex.finding",
          "group": "2_rule@1"
        },
        {
          "command": "nephilex.openRuleDocs",
          "when": "view == nephilex.findings && viewItem == nephilex.finding",
          "group": "2_rule@2"
        }
      ],
      "explorer/context": [
        {
          "command": "nephilex.scanResource",
          "when": "isWorkspaceTrusted && resourceScheme == file",
          "group": "4_search@9"
        }
      ],
      "editor/title": [
        {
          "command": "nephilex.scanFile",
          "when": "isWorkspaceTrusted && resourceScheme == file && config.nephilex.showScanButton",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "Nephilex",
      "properties": {
        "nephilex.run": {
          "type": "string",
          "enum": [
            "off",
            "onSave",
            "onType"
          ],
          "enumDescriptions": [
            "Only scan when a command is run.",
            "Scan a file when it is saved.",
            "Scan a file while typing, after a short pause (see nephilex.debounceMs)."
          ],
          "default": "onSave",
          "description": "When to scan files automatically. Nothing runs automatically in Restricted Mode."
        },
        "nephilex.debounceMs": {
          "type": "number",
          "default": 800,
          "minimum": 200,
          "maximum": 10000,
          "description": "Delay in milliseconds after the last edit before an on-type scan starts."
        },
        "nephilex.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the nephilex executable. Leave empty to search PATH. Ignored when nephilex.pythonPath is set."
        },
        "nephilex.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to a Python interpreter that has nephilex installed. When set, Nephilex runs as `python -m nephilex`."
        },
        "nephilex.minSeverity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "default": "low",
          "description": "Only show findings at or above this severity."
        },
        "nephilex.scanners": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "default": [],
          "description": "Scanners to run (see `nephilex scanners`). Empty runs the CLI default set."
        },
        "nephilex.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to the nephilex CLI, one argument per item. Output and format flags are managed by the extension and are dropped."
        },
        "nephilex.offlineEnrichment": {
          "type": "boolean",
          "default": true,
          "description": "Pass --ai-provider heuristic --patches so hovers include offline reasoning and verified deterministic fixes. No network AI calls are made. When false, --no-ai is passed."
        },
        "nephilex.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 3600,
          "description": "Fail-safe timeout for a single-file scan. The CLI process is killed when it is exceeded."
        },
        "nephilex.workspaceTimeoutSeconds": {
          "type": "number",
          "default": 900,
          "minimum": 30,
          "maximum": 21600,
          "description": "Fail-safe timeout for a workspace scan. The CLI process is killed when it is exceeded."
        },
        "nephilex.maxOutputMB": {
          "type": "number",
          "default": 64,
          "minimum": 1,
          "maximum": 512,
          "description": "Maximum size of CLI output read by the extension. The scan is aborted when it is exceeded."
        },
        "nephilex.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Register the Nephilex MCP server (`nephilex mcp`) for agent mode when the editor supports the MCP server definition API."
        },
        "nephilex.showScanButton": {
          "type": "boolean",
          "default": true,
          "description": "Show the Scan Current File button (shield icon) in the editor title bar."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "nephilex",
        "label": "nephilex"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nephilex",
          "title": "Nephilex",
          "icon": "images/activitybar.svg"
        }
      ]
    },
    "views": {
      "nephilex": [
        {
          "id": "nephilex.findings",
          "name": "Findings",
          "contextualTitle": "Nephilex"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nephilex.findings",
        "when": "nephilex.cliState == untrusted",
        "contents": "Nephilex does not run in Restricted Mode, so nothing in this workspace is scanned.\n[Manage Workspace Trust](command:workbench.trust.manage)"
      },
      {
        "view": "nephilex.findings",
        "when": "nephilex.cliState == missing",
        "contents": "The Nephilex CLI was not found. The extension runs the open-source nephilex scanner on your machine; it needs Python 3.10 or later, or pipx.\n[Install Nephilex](command:nephilex.installCli)\nAlready installed somewhere else? Set nephilex.executablePath or nephilex.pythonPath in [Settings](command:workbench.action.openSettings?%22nephilex%22)."
      },
      {
        "view": "nephilex.findings",
        "when": "nephilex.cliState != untrusted && nephilex.cliState != missing && !nephilex.hasFindings && !nephilex.scanned",
        "contents": "No scan has run yet. Scan the workspace to see findings grouped by severity, with the evidence for each one.\n[Scan Workspace](command:nephilex.scanWorkspace)\nNephilex needs its command line tool. If it is not installed yet:\n[Install Nephilex](command:nephilex.installCli)\nNew to Nephilex? Open the [getting started walkthrough](command:workbench.action.openWalkthrough?%22nephilex.nephilex%23nephilex.gettingStarted%22)."
      },
      {
        "view": "nephilex.findings",
        "when": "nephilex.cliState != untrusted && nephilex.cliState != missing && !nephilex.hasFindings && nephilex.scanned",
        "contents": "The last scan reported no findings at or above nephilex.minSeverity. No scanner finds every issue, so keep reviewing code and dependencies.\n[Scan Workspace](command:nephilex.scanWorkspace)"
      },
      {
        "view": "nephilex.findings",
        "when": "nephilex.hasFindings",
        "contents": "All findings are hidden by the current filter.\n[Reset Filter](command:nephilex.resetFilter)"
      }
    ],
    "walkthroughs": [
      {
        "id": "nephilex.gettingStarted",
        "title": "Get Started with Nephilex",
        "description": "Install the open-source Nephilex scanner, run a first scan, read the evidence for a finding, and add Nephilex to CI.",
        "steps": [
          {
            "id": "install",
            "title": "Install the Nephilex CLI",
            "description": "The extension runs the nephilex command line tool on your machine. Install it with pipx or pip; you confirm the command before anything runs.\n[Install Nephilex](command:nephilex.installCli)",
            "media": {
              "markdown": "walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:nephilex.cliState == ready"
            ]
          },
          {
            "id": "scan",
            "title": "Run a first scan",
            "description": "Scan the whole workspace, or right-click a folder or file in the Explorer and choose Scan with Nephilex.\n[Scan Workspace](command:nephilex.scanWorkspace)",
            "media": {
              "markdown": "walkthrough/scan.md"
            },
            "completionEvents": [
              "onContext:nephilex.scanned"
            ]
          },
          {
            "id": "evidence",
            "title": "Read a finding and its evidence",
            "description": "Open a finding from the Findings view and hover over it to see the evidence grade, the data-flow path, and how to verify it.\n[Show Findings](command:nephilex.showFindings)",
            "media": {
              "markdown": "walkthrough/evidence.md"
            },
            "completionEvents": [
              "onCommand:nephilex.openFinding",
              "onView:nephilex.findings"
            ]
          },
          {
            "id": "ignore",
            "title": "Ignore a false positive with a reason",
            "description": "Suppress a finding you have checked, with a reason that stays next to the code for reviewers.",
            "media": {
              "markdown": "walkthrough/ignore.md"
            },
            "completionEvents": [
              "onCommand:nephilex.ignoreFinding",
              "onCommand:nephilex.ignoreFromView"
            ]
          },
          {
            "id": "ci",
            "title": "Set up CI",
            "description": "Run the same scan on every pull request.\n[Open the CI/CD guide](https://nephilex.github.io/nephilex/ci-cd/)",
            "media": {
              "markdown": "walkthrough/ci.md"
            },
            "completionEvents": [
              "onLink:https://nephilex.github.io/nephilex/ci-cd/"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compile:tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile:tests && mocha --config .mocharc.json",
    "test:integration": "npm run build && npm run compile:tests && node out/test/integration/runTest.js",
    "test": "npm run test:unit && npm run test:integration",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.25",
    "@types/vscode": "1.93.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "mocha": "11.8.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "diff": "8.0.4",
    "serialize-javascript": "7.1.2"
  }
}
